#!/bin/bash
#PBS -N dsads_full_serial
#PBS -P personal-<id>
#PBS -q normal
#PBS -l select=1:ncpus=1:mem=24gb
#PBS -l walltime=00:180:00
#PBS -j oe

cd $PBS_O_WORKDIR
module load nvhpc/23.7 openmpi/4.1.2-hpe

echo "=== DSADS Full Serial (3 Repetitions) ==="

for run in {1..3}; do
    echo "--- Repetition $run of 3 ---"

    ./executables/pca_serial data/dsads/dsads_full.txt 5 1 dsads_full_serial

    echo ""
done