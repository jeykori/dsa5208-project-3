#!/bin/bash
#PBS -N msd_serial
#PBS -P personal-<id>
#PBS -q normal
#PBS -l select=1:ncpus=1:mem=24gb
#PBS -l walltime=00:30:00
#PBS -j oe

cd $PBS_O_WORKDIR
module load nvhpc/23.7 openmpi/4.1.2-hpe

echo "=== YearPredictionMSD Serial Benchmark (3 Repetitions) ==="

for run in {1..3}; do
    echo "--- Repetition $run of 3 ---"

    ./executables/pca_serial data/year-prediction-msd/msd_full.txt 5 1 msd_serial

    echo ""
done