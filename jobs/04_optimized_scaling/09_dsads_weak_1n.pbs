#!/bin/bash
#PBS -N dsads_weak_1n
#PBS -P personal-<id>
#PBS -q normal
#PBS -l select=1:ncpus=64:mpiprocs=1:ompthreads=64:mem=64gb
#PBS -l walltime=00:30:00
#PBS -j oe

cd $PBS_O_WORKDIR
module load nvhpc/23.7 openmpi/4.1.2-hpe

export OMP_NUM_THREADS=64
RANKS=1

echo "=== DSADS Weak Scaling: 1 Node (1 Rank x 64 Threads) + 1k Dataset ==="

for run in {1..5}; do
    echo "--- Repetition $run of 5 ---"
    mpiexec -n $RANKS --map-by ppr:1:node:PE=64 --bind-to core ./executables/pca_optimized data/dsads/dsads_1000.txt 5 1 dsads_weak_1node
    echo ""
done
